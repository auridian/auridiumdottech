body,html{background-color:#0b0f12!important;color:#fff!important;font-family:montserrat,sans-serif!important}.cyberpunk-theme{background:radial-gradient(circle at 18% 12%,rgba(56,215,255,.12),transparent 28rem),radial-gradient(circle at 86% 18%,rgba(244,184,96,8%),transparent 24rem),linear-gradient(180deg,#0b0f12 0%,#071014 44%,#050708 100%);color:#fff;font-family:montserrat,sans-serif}.cyberpunk-theme .neon-text,.cyberpunk-theme .section-title{text-shadow:0 0 14px rgba(56,215,255,.3);color:#d7f8ff}.cyberpunk-theme .neon-text-pink{text-shadow:0 0 5px #ff4f88,0 0 10px #ff4f88,0 0 20px #ff4f88;color:#ff4f88}.cyberpunk-theme .site-navigation{position:sticky;top:0;z-index:1020;width:100%;background-color:rgba(5,7,8,.75);backdrop-filter:blur(14px);border-bottom:1px solid rgba(142,164,184,.18);transition:background-color .3s ease,border-color .3s ease,box-shadow .3s ease;box-shadow:0 0 transparent}.cyberpunk-theme .site-navigation .navbar-brand{padding:0;margin:0}.cyberpunk-theme .site-navigation .navbar-brand img{max-width:50px;max-height:50px;width:auto;height:auto;object-fit:contain}.cyberpunk-theme .site-navigation .nav-link{color:#fff!important}.cyberpunk-theme .site-navigation .nav-link:hover{color:#f4b860!important}.cyberpunk-theme .site-navigation.nav-bg{background-color:rgba(5,7,8,.95);border-bottom-color:rgba(244,184,96,.32);box-shadow:0 12px 30px rgba(0,0,0,.45)}.cyberpunk-theme .site-feature{background:rgba(16,23,29,.68);border:1px solid rgba(142,164,184,.2);border-radius:2px;padding:2rem;transition:all .3s ease;margin-bottom:2rem}.cyberpunk-theme .site-feature:hover{transform:translateY(-5px);border-color:rgba(244,184,96,.65);box-shadow:0 24px 50px rgba(0,0,0,.28)}.cyberpunk-theme .site-feature .icon{color:#38d7ff;font-size:2.5rem;margin-bottom:1rem}.cyberpunk-theme .site-feature h3{color:#fff;margin-bottom:1rem}.cyberpunk-theme .site-feature p{color:#a8b5bf}.cyberpunk-theme .section{padding:5rem 0}.cyberpunk-theme .section-title{margin-bottom:1rem;font-size:2.5rem;text-transform:none;letter-spacing:1px}.cyberpunk-theme .section-subtitle{color:#a8b5bf;margin-bottom:3rem;font-size:1.2rem}.cyberpunk-theme .btn-primary{background:linear-gradient(135deg,#f4b860,#f06f45)!important;border:none!important;color:#fff!important;padding:.75rem 1.5rem!important;border-radius:4px!important;font-weight:600!important;transition:all .3s ease!important}.cyberpunk-theme .btn-primary:hover{transform:translateY(-2px)!important;box-shadow:0 16px 35px rgba(244,184,96,.22)!important}.cyberpunk-theme .btn-secondary{background:0 0!important;border:2px solid rgba(56,215,255,.72)!important;color:#d7f8ff!important;padding:.75rem 1.5rem!important;border-radius:4px!important;font-weight:600!important;transition:all .3s ease!important}.cyberpunk-theme .btn-secondary:hover{background:rgba(56,215,255,8%)!important;transform:translateY(-2px)!important}.cyberpunk-theme .site-footer{background-color:#050708!important;border-top:1px solid rgba(142,164,184,.22)!important;padding:2rem 0!important;margin-top:4rem!important}.cyberpunk-theme .site-footer .site-footer-logo{margin-bottom:2rem}.cyberpunk-theme .site-footer .site-footer-logo img{max-width:50px;max-height:50px;width:auto;height:auto;object-fit:contain}.cyberpunk-theme .site-footer .site-footer-widget{margin-bottom:2rem}.cyberpunk-theme .site-footer .site-footer-widget-title{color:#eef5f7!important;margin-bottom:1.5rem;font-size:.85rem;letter-spacing:.16em;text-transform:uppercase}.cyberpunk-theme .site-footer .site-footer-widget-description{color:#a8b5bf!important}.cyberpunk-theme .site-footer .site-footer-widget-description a{color:#d7f8ff!important;border-bottom:1px solid rgba(56,215,255,.24);text-decoration:none}.cyberpunk-theme .site-footer .site-footer-widget-description a:hover{color:#f4b860!important;border-bottom-color:rgba(244,184,96,.72);text-shadow:none}.cyberpunk-theme .site-footer .site-footer-widget-links{list-style:none;padding:0;margin:0}.cyberpunk-theme .site-footer .site-footer-widget-links li{margin-bottom:.65rem}.cyberpunk-theme .site-footer .site-footer-widget-links li a{display:inline-flex;align-items:center;gap:.45rem;color:#a8b5bf!important;text-decoration:none;transition:color .2s ease,transform .2s ease}.cyberpunk-theme .site-footer .site-footer-widget-links li a::before{content:'/';color:rgba(142,164,184,.55);transition:color .2s ease}.cyberpunk-theme .site-footer .site-footer-widget-links li a:hover{color:#f4b860!important;text-shadow:none;transform:translateX(2px)}.cyberpunk-theme .site-footer .site-footer-widget-links li a:hover::before{color:rgba(244,184,96,.8)}.cyberpunk-theme .site-footer .site-footer-copyright{margin-top:2rem;padding-top:2rem;border-top:1px solid rgba(56,215,255,.1);text-align:center;color:#a8b5bf!important}.cyberpunk-theme .site-footer .site-footer-copyright a{color:#d7f8ff!important;text-decoration:none;border-bottom:1px solid rgba(56,215,255,.24);transition:color .2s ease,border-color .2s ease}.cyberpunk-theme .site-footer .site-footer-copyright a:hover{color:#f4b860!important;border-bottom-color:rgba(244,184,96,.72);text-shadow:none}.cyberpunk-theme .site-footer .site-footer-widget-top{display:inline-flex;align-items:center;gap:.6rem;color:#a8b5bf!important;text-decoration:none;border:1px solid rgba(142,164,184,.2);padding:.75rem .85rem;background:rgba(16,23,29,.45);transition:border-color .2s ease,color .2s ease,transform .2s ease,background .2s ease}.cyberpunk-theme .site-footer .site-footer-widget-top img{width:14px;height:14px;filter:grayscale(1)brightness(1.6)sepia(.2)saturate(.4);opacity:.72;transition:filter .2s ease,opacity .2s ease,transform .2s ease}.cyberpunk-theme .site-footer .site-footer-widget-top p{margin:0;color:inherit!important;font-size:.75rem;letter-spacing:.12em;text-transform:uppercase}.cyberpunk-theme .site-footer .site-footer-widget-top:hover{color:#f4b860!important;border-color:rgba(244,184,96,.62);background:rgba(244,184,96,8%);transform:translateY(-2px);text-shadow:none}.cyberpunk-theme .site-footer .site-footer-widget-top:hover img{opacity:1;transform:translateY(-1px);filter:brightness(0)saturate(100%)invert(78%)sepia(51%)saturate(534%)hue-rotate(344deg)brightness(101%)contrast(91%)}.lab-hero{position:relative;min-height:clamp(560px,92vh,880px);padding:clamp(5rem,8vw,7rem)0;background-color:#0b0f12;background-image:linear-gradient(rgba(142,164,184,.055) 1px,transparent 1px),linear-gradient(90deg,rgba(142,164,184,.055) 1px,transparent 1px),radial-gradient(circle at 72% 22%,rgba(56,215,255,.18),transparent 22rem),radial-gradient(circle at 18% 72%,rgba(244,184,96,.12),transparent 26rem),var(--hero-bg);background-size:48px 48px,48px 48px,auto,auto,cover;background-position:50%;background-repeat:repeat,repeat,no-repeat,no-repeat,no-repeat;display:flex;align-items:center;justify-content:center;overflow:hidden}.lab-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(110deg,rgba(5,7,8,.96) 0%,rgba(11,15,18,.88) 46%,rgba(5,7,8,.72) 100%),repeating-linear-gradient(90deg,rgba(142,164,184,4%) 0 1px,transparent 1px 80px);backdrop-filter:blur(5px)saturate(.8)}.lab-hero::after{content:'AT-LAB / SYSTEMS / FIELDWORK';position:absolute;right:clamp(1rem,4vw,4rem);bottom:clamp(1rem,4vw,3rem);color:rgba(142,164,184,.32);font-size:.75rem;letter-spacing:.28em;writing-mode:vertical-rl;pointer-events:none}.lab-hero .container{position:relative;z-index:1}.lab-hero__panel{max-width:920px;margin:0 auto;background:linear-gradient(145deg,rgba(16,23,29,.9),rgba(5,7,8,.78));padding:clamp(2rem,5vw,4rem);border:1px solid rgba(142,164,184,.28);border-left:4px solid rgba(244,184,96,.9);border-radius:2px;box-shadow:0 30px 80px rgba(0,0,0,.45);backdrop-filter:blur(16px)}.lab-hero__kicker{color:#f4b860;font-size:.85rem;text-transform:uppercase;letter-spacing:.24em;margin-bottom:1.1rem;text-shadow:none}.lab-hero__headline{color:#f6fbff;font-size:clamp(2.8rem,7vw,5.75rem);line-height:.95;margin-bottom:1.35rem;letter-spacing:-.06em;text-shadow:0 0 24px rgba(56,215,255,.22)}.lab-hero__intro{max-width:760px;margin:0 auto 2rem;color:#a8b5bf;font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.65}.lab-section{position:relative}.lab-section::before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent,rgba(5,7,8,.35)),radial-gradient(circle at 10% 10%,rgba(56,215,255,6%),transparent 22rem);pointer-events:none}.lab-section .container{position:relative;z-index:1}.lab-section--projects{background:linear-gradient(rgba(56,215,255,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(56,215,255,.045) 1px,transparent 1px),radial-gradient(circle at 70% 20%,rgba(155,124,255,.11),transparent 25rem);background-size:44px 44px,44px 44px,auto}.lab-section--projects .section-card--project{border-color:rgba(56,215,255,.28)}.lab-section--projects .section-card--project:hover{border-color:rgba(56,215,255,.75);box-shadow:0 24px 55px rgba(0,0,0,.32),inset 3px 0 rgba(56,215,255,.8)}.section-card{display:block;background:linear-gradient(145deg,rgba(16,23,29,.92),rgba(5,7,8,.82)),linear-gradient(90deg,rgba(56,215,255,8%),transparent);border:1px solid rgba(142,164,184,.2);border-radius:2px;padding:2rem;margin-bottom:2rem;transition:all .3s ease;text-decoration:none;backdrop-filter:blur(10px)}.section-card:hover{transform:translateY(-6px);border-color:rgba(244,184,96,.66);box-shadow:0 24px 55px rgba(0,0,0,.32),inset 3px 0 rgba(244,184,96,.75);text-decoration:none}.section-card-content{text-align:center}.section-card-content .fa{font-size:3rem;color:#f4b860;margin-bottom:1.5rem;transition:color .3s ease,text-shadow .3s ease}.section-card-content h3{color:#fff;font-size:1.5rem;margin-bottom:1rem;transition:color .3s ease,text-shadow .3s ease}.section-card-content p{color:#a8b5bf;margin-bottom:0;line-height:1.6}.section-card:hover .section-card-content .fa{color:#38d7ff;text-shadow:0 0 10px rgba(56,215,255,.25)}.section-card:hover .section-card-content h3{color:#d7f8ff;text-shadow:0 0 8px rgba(56,215,255,.22)}.site-sections,.cyberpunk-section{padding:clamp(3.5rem,6vw,5rem)0;background:linear-gradient(rgba(142,164,184,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(142,164,184,.035) 1px,transparent 1px);background-size:44px 44px}.cyberpunk-section{background:linear-gradient(rgba(142,164,184,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(142,164,184,.035) 1px,transparent 1px);background-size:44px 44px}.section-title{text-align:center;margin-bottom:3rem}.section-title h2{color:#d7f8ff;font-size:clamp(2rem,4vw,2.75rem);margin-bottom:1rem;text-shadow:0 0 14px rgba(56,215,255,.25)}.section-title p{color:#a8b5bf;font-size:1.2rem}.cyberpunk-hero{position:relative;min-height:clamp(540px,100vh,960px);padding:clamp(4rem,6vw,6rem)0;background-color:#0b0f12;background-image:linear-gradient(rgba(142,164,184,5%) 1px,transparent 1px),linear-gradient(90deg,rgba(142,164,184,5%) 1px,transparent 1px),var(--hero-bg);background-size:52px 52px,52px 52px,cover;background-size:cover;background-position:50%;background-repeat:no-repeat;display:flex;align-items:center;justify-content:center}.cyberpunk-hero::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(5,7,8,.92),rgba(11,15,18,.72)),radial-gradient(circle at 50% 10%,rgba(56,215,255,.1),transparent 28rem);backdrop-filter:blur(5px)saturate(.8)}.cyberpunk-hero .container{position:relative;z-index:1}.cyberpunk-hero__panel{background:linear-gradient(145deg,rgba(16,23,29,.86),rgba(5,7,8,.78));padding:clamp(2rem,5vw,3.5rem);border-radius:2px;border:1px solid rgba(142,164,184,.25);border-left:4px solid rgba(244,184,96,.86);box-shadow:0 20px 45px rgba(0,0,0,.4);backdrop-filter:blur(12px)}.cyberpunk-hero__tagline{color:#f4b860;font-size:1.15rem;text-transform:uppercase;letter-spacing:.18em;margin-bottom:1rem;text-shadow:0 0 9px rgba(244,184,96,.18)}.cyberpunk-hero__headline{font-size:clamp(2.5rem,5vw,3.75rem);margin-bottom:1.5rem;color:#f6fbff;text-shadow:0 0 22px rgba(56,215,255,.24)}.cyberpunk-hero__intro{max-width:720px;margin:0 auto 2rem;color:#a8b5bf;font-size:1.2rem;line-height:1.7}.site-hero-content-buttons{display:flex;flex-wrap:wrap;justify-content:center;gap:1rem;padding-left:0;margin-bottom:0}.site-hero-content-buttons li{list-style:none}.cyberpunk-theme .site-feature,.cyberpunk-theme .site-team,.cyberpunk-theme .site-testimonial,.cyberpunk-theme .site-blog,.cyberpunk-theme .site-about{background-color:rgba(5,7,8,.5)!important;color:#fff!important}.cyberpunk-theme .site-feature h1,.cyberpunk-theme .site-feature h2,.cyberpunk-theme .site-feature h3,.cyberpunk-theme .site-feature h4,.cyberpunk-theme .site-feature h5,.cyberpunk-theme .site-feature h6,.cyberpunk-theme .site-team h1,.cyberpunk-theme .site-team h2,.cyberpunk-theme .site-team h3,.cyberpunk-theme .site-team h4,.cyberpunk-theme .site-team h5,.cyberpunk-theme .site-team h6,.cyberpunk-theme .site-testimonial h1,.cyberpunk-theme .site-testimonial h2,.cyberpunk-theme .site-testimonial h3,.cyberpunk-theme .site-testimonial h4,.cyberpunk-theme .site-testimonial h5,.cyberpunk-theme .site-testimonial h6,.cyberpunk-theme .site-blog h1,.cyberpunk-theme .site-blog h2,.cyberpunk-theme .site-blog h3,.cyberpunk-theme .site-blog h4,.cyberpunk-theme .site-blog h5,.cyberpunk-theme .site-blog h6,.cyberpunk-theme .site-about h1,.cyberpunk-theme .site-about h2,.cyberpunk-theme .site-about h3,.cyberpunk-theme .site-about h4,.cyberpunk-theme .site-about h5,.cyberpunk-theme .site-about h6{color:#fff!important}.cyberpunk-theme .site-feature p,.cyberpunk-theme .site-team p,.cyberpunk-theme .site-testimonial p,.cyberpunk-theme .site-blog p,.cyberpunk-theme .site-about p{color:#a8b5bf!important}@media(max-width:768px){.feature-card{margin-bottom:2rem}.section,.site-sections,.cyberpunk-section{padding:3rem 0}.cyberpunk-hero__headline{font-size:2.25rem}.lab-hero{min-height:auto;padding:6rem 0 4rem}.lab-hero::after{display:none}.lab-hero__panel{margin:0 1rem}.lab-hero__headline{font-size:3rem}}@keyframes glow{0%{box-shadow:0 0 5px rgba(56,215,255,.5)}50%{box-shadow:0 0 20px rgba(56,215,255,.8)}100%{box-shadow:0 0 5px rgba(56,215,255,.5)}}.glow-effect{animation:glow 2s infinite}.alpha-form{max-width:600px;margin:2rem auto;padding:2rem;background:rgba(5,7,8,.5);border:1px solid rgba(56,215,255,.2);border-radius:8px}.alpha-form .form-group{margin-bottom:1.5rem}.alpha-form .form-group label{display:block;margin-bottom:.5rem;color:#38d7ff;font-weight:500}.alpha-form .form-group input,.alpha-form .form-group textarea,.alpha-form .form-group select{width:100%;padding:.75rem;background:rgba(11,15,18,.8);border:1px solid rgba(56,215,255,.3);border-radius:4px;color:#fff;transition:all .3s ease}.alpha-form .form-group input:focus,.alpha-form .form-group textarea:focus,.alpha-form .form-group select:focus{outline:none;border-color:#38d7ff;box-shadow:0 0 10px rgba(56,215,255,.3)}.alpha-form .form-group textarea{resize:vertical;min-height:100px}.content-page{max-width:800px;margin:6rem auto 2rem;padding:2rem;background:rgba(16,23,29,.78);border:1px solid rgba(142,164,184,.2);border-left:4px solid rgba(244,184,96,.7);border-radius:2px;backdrop-filter:blur(10px);position:relative}.content-page h1{font-size:3rem;margin-bottom:1rem;color:#f3f6f7;text-shadow:none;letter-spacing:-.04em;border-bottom:1px solid rgba(142,164,184,.24);padding-bottom:1rem}.content-page .lead{font-size:1.25rem;color:#fff;margin-bottom:2rem;text-transform:uppercase;letter-spacing:1px;text-shadow:0 0 5px rgba(56,215,255,.5)}.content-page h2{color:#f4b860;margin:2.5rem 0 1rem;font-size:2rem;text-shadow:0 0 8px rgba(244,184,96,.18)}.content-page h3{color:#d7f8ff;margin:2rem 0 1rem;font-size:1.5rem;text-shadow:0 0 8px rgba(56,215,255,.2)}.content-page p{margin-bottom:1.5rem;line-height:1.6;color:#fff}.content-page ul,.content-page ol{margin-bottom:1.5rem;padding-left:1.5rem}.content-page ul li,.content-page ol li{margin-bottom:.75rem;color:#fff}.content-page ul li strong,.content-page ol li strong{color:#38d7ff}.content-page a{color:#d7f8ff;text-decoration:none;transition:all .3s ease;position:relative}.content-page a:hover{color:#f4b860;text-shadow:none}.content-page .project-cta{display:inline-flex;align-items:center;margin:.75rem 0 1.5rem;padding:.8rem 1.1rem;border:1px solid rgba(244,184,96,.58);background:linear-gradient(135deg,rgba(244,184,96,.18),rgba(240,111,69,.1));color:#fff7e8;font-weight:700;letter-spacing:.02em;text-transform:uppercase;font-size:.82rem}.content-page .project-cta::after{content:'>';margin-left:.75rem;color:#f4b860}.content-page .project-cta:hover{border-color:rgba(244,184,96,.9);color:#fff;background:linear-gradient(135deg,rgba(244,184,96,.28),rgba(240,111,69,.16));transform:translateY(-1px)}.content-page blockquote{border-left:4px solid #f4b860;padding:1rem 1.5rem;margin:2rem 0;background:rgba(5,7,8,.5);border-radius:0 8px 8px 0}.content-page blockquote p{margin:0;font-style:italic;color:#a8b5bf}.content-page code{background:rgba(5,7,8,.8);padding:.2rem .4rem;border-radius:4px;font-family:fira code,monospace;color:#f4b860}.content-page pre{background:rgba(5,7,8,.8);padding:1.5rem;border-radius:8px;border:1px solid rgba(142,164,184,.2);overflow-x:auto;margin:1.5rem 0}.content-page pre code{background:0 0;padding:0;color:#fff}.content-page::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(rgba(142,164,184,6%) 1px,transparent 1px),linear-gradient(90deg,rgba(142,164,184,6%) 1px,transparent 1px);background-size:28px 28px;pointer-events:none;z-index:-1;opacity:.5}.feature-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:2rem;margin:3rem 0}.timeline{position:relative;padding:2rem 0}.timeline::before{content:'';position:absolute;left:50%;top:0;bottom:0;width:2px;background:linear-gradient(to bottom,#38d7ff,#ff4f88)}.timeline .timeline-item{margin:2rem 0;position:relative}.timeline .timeline-item::before{content:'';position:absolute;left:50%;top:0;width:20px;height:20px;background:#38d7ff;border-radius:50%;transform:translateX(-50%)}.timeline .timeline-item .timeline-content{width:calc(50% - 30px);padding:1.5rem;background:rgba(5,7,8,.5);border:1px solid rgba(56,215,255,.2);border-radius:8px}.timeline .timeline-item .timeline-content h3{color:#38d7ff;margin-bottom:1rem}.timeline .timeline-item:nth-child(odd) .timeline-content{margin-left:auto}@media(max-width:768px){.timeline::before{left:0}.timeline .timeline-item::before{left:0}.timeline .timeline-item .timeline-content{width:calc(100% - 30px);margin-left:30px!important}.alpha-form{padding:1rem}.content-page{padding:1rem}.content-page h1{font-size:2rem}}.site-hero{position:relative;min-height:100vh;height:auto;background-size:cover!important;background-position:50%!important;background-repeat:no-repeat!important;display:flex;align-items:center;justify-content:center;padding:100px 0;margin:0;border:none}.site-hero::before{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(135deg,rgba(5,7,8,.9),rgba(11,15,18,.68))}.site-hero .site-hero-content{position:relative;z-index:2;background:rgba(16,23,29,.82);padding:3rem;border-radius:2px;border:1px solid rgba(142,164,184,.22);border-left:4px solid rgba(244,184,96,.8);backdrop-filter:blur(10px);max-width:800px;margin:0 auto}.site-hero .site-hero-content h1{font-size:3.5rem;margin-bottom:1.5rem;color:#f6fbff;text-shadow:0 0 20px rgba(56,215,255,.24)}@media(max-width:768px){.site-hero .site-hero-content h1{font-size:2.5rem}}.site-hero .site-hero-content h5{color:#f4b860;font-size:1.25rem;margin-bottom:1rem;text-transform:uppercase;letter-spacing:2px;text-shadow:0 0 8px rgba(244,184,96,.18)}.site-hero .site-hero-content .site-hero-content-buttons{margin-top:2rem;padding:0;list-style:none}.site-hero .site-hero-content .site-hero-content-buttons li{display:inline-block;margin:.5rem}@media(max-width:768px){.site-hero .site-hero-content .site-hero-content-buttons li{display:block;margin:1rem 0}}.site-sections{padding:4rem 0}.site-sections .section-title{text-align:center;margin-bottom:3rem}.site-sections .section-title h2{color:#d7f8ff;font-size:2.5rem;margin-bottom:1rem;text-shadow:0 0 14px rgba(56,215,255,.22)}.site-sections .section-title p{color:#a8b5bf;font-size:1.25rem;text-transform:uppercase;letter-spacing:2px}.section-card{display:block;background:rgba(16,23,29,.88);border:1px solid rgba(142,164,184,.2);border-radius:2px;padding:2rem;margin-bottom:2rem;transition:all .3s ease;text-decoration:none;backdrop-filter:blur(10px)}.section-card:hover{transform:translateY(-5px);border-color:rgba(244,184,96,.66);box-shadow:0 24px 50px rgba(0,0,0,.32);text-decoration:none}.section-card:hover .fa{color:#38d7ff;text-shadow:0 0 10px rgba(56,215,255,.28)}.section-card:hover h3{color:#d7f8ff;text-shadow:0 0 8px rgba(56,215,255,.2)}.section-card .section-card-content{text-align:center}.section-card .section-card-content .fa{font-size:3rem;color:#fff;margin-bottom:1.5rem;transition:all .3s ease}.section-card .section-card-content h3{color:#fff;font-size:1.5rem;margin-bottom:1rem;transition:all .3s ease}.section-card .section-card-content p{color:#a8b5bf;margin-bottom:0;line-height:1.6}@media(max-width:768px){.section-card{margin-left:1rem;margin-right:1rem}}.about-content h1{font-size:3rem;margin-bottom:2rem;color:#f3f6f7;text-shadow:none;text-align:center;line-height:1.2;letter-spacing:-.04em;border-bottom:1px solid rgba(142,164,184,.24);padding-bottom:1rem}@media(max-width:768px){.about-content h1{font-size:2.5rem}}.about-content .about-description p{font-size:1.2rem;line-height:1.8;margin-bottom:2rem;color:#fff;text-align:justify}.about-content .about-description p:first-child{font-size:1.3rem;color:#dbe6eb;font-weight:400;text-shadow:none}.about-content .about-description p:last-child{margin-bottom:0}.about-content .about-description strong{color:#f4b860;text-shadow:none}.about-content .about-description em{color:#38d7ff;font-style:italic}.how-it-works-hero{margin:3rem 0 4rem;text-align:center}.how-it-works-hero img{max-width:100%;height:auto;border-radius:8px;border:2px solid rgba(56,215,255,.3);box-shadow:0 0 20px rgba(56,215,255,.2);transition:all .3s ease}.how-it-works-hero img:hover{border-color:#38d7ff;box-shadow:0 0 30px rgba(56,215,255,.4);transform:translateY(-2px)}.how-it-works-hero figcaption{margin-top:1rem;color:#a8b5bf;font-style:italic;font-size:1.1rem;line-height:1.6;max-width:600px;margin-left:auto;margin-right:auto;text-shadow:0 0 5px rgba(56,215,255,.2)}@media(max-width:768px){.how-it-works-hero figcaption{font-size:1rem;margin-top:.75rem}}@media(max-width:768px){.how-it-works-hero{margin:2rem 0 3rem}}